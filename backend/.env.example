# Copy to backend/.env. The API refuses to start without JWT_SECRET and FIELD_ENCRYPTION_KEY.
MONGODB_URI=mongodb://localhost:27017/tps_los?replicaSet=rs0
MONGODB_DB=tps_los
JWT_SECRET=replace-with-a-long-random-string
FIELD_ENCRYPTION_KEY=replace-with-another-long-random-string
ADMIN_INITIAL_PASSWORD=replace-with-a-password-meeting-the-policy
CLIENT_ORIGIN=http://localhost:5173
DEMO_MODE=true
FEATURES_EXTENDED=false
PORT=4000
